# Server
APP_ENV=development
PORT=8080
# Bisa lebih dari satu origin, pisahkan dengan koma.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173

# Database
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable

# Auth (generate dengan: openssl rand -hex 32)
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
COOKIE_SECURE=false

# Seed admin (dipakai oleh cmd/seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ubah-password-ini

# Upload gambar
UPLOAD_DIR=./uploads
