# Salin nilai di bawah ke Environment Variables di Render.
# Jangan commit file .env dengan nilai asli.

APP_ENV=production
# PORT diisi otomatis oleh Render; baris ini hanya referensi lokal.
PORT=8080

# Connection string dari Neon. Pastikan sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# URL Vercel frontend. WAJIB sama persis dengan origin yang dipakai browser,
# kalau tidak route /api/v1/admin/* akan ditolak (403 origin tidak diizinkan).
FRONTEND_ORIGIN=https://PORTFOLIO-VERCEL-PROJECT.vercel.app

# Generate dengan: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-64-karakter-acak

# HTTPS di Vercel, cookie admin harus Secure.
COOKIE_SECURE=true

# Kredensial admin production (jangan pakai password development).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-password-yang-kuat
ADMIN_NAME=Jonathan Adi Saputro

# Path upload di dalam container. Render tidak punya disk persisten di plan free.
UPLOAD_DIR=/app/uploads
