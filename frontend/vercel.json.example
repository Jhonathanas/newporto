{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR_BACKEND.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://YOUR_BACKEND.onrender.com/uploads/$1"
    },
    {
      "source": "/health",
      "destination": "https://YOUR_BACKEND.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
